{
  "name": "TodoBox",
  "short_name": "TodoBox",
  "description": "Local task manager — same database as the Chrome extension",
  "start_url": "/app.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f2eb",
  "theme_color": "#0f6e62",
  "icons": [
    { "src": "icons/icon192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
